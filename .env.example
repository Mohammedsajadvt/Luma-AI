# MongoDB Connection URI (e.g. MongoDB Atlas or local mongodb://localhost:27017/luma_ai)
MONGODB_URI=mongodb://localhost:27017/luma_ai

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_generate_with_openssl_rand_base64_32

# Google OAuth 2.0 Credentials (from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OpenAI API Key (from https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
